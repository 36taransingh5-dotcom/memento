# ---------------------------------------------------------------------------
# Memento environment configuration
#
# Copy to `.env.local` and fill in. Never commit real credentials.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# === CockroachDB (required) =================================================

# Full CockroachDB connection string. Memento uses CockroachDB for ALL
# persistent state — structured records and vector memory alike.
#
# Local development (docker compose up -d):
DATABASE_URL=postgresql://root@localhost:26257/memento?sslmode=disable
#
# CockroachDB Cloud (copy from the Cloud Console -> Connect -> General connection string):
# DATABASE_URL=postgresql://<user>:<password>@<host>:26257/memento?sslmode=verify-full

# Maximum pooled connections. CockroachDB Cloud Basic clusters are metered on
# connection count; keep this modest for serverless deployments.
DATABASE_POOL_MAX=10


# === Amazon Bedrock (required for real agent reasoning) =====================

# Region hosting your Bedrock model access. Model access on a self-service AWS
# account is not the same as an "available" model in the console — plan on
# some trial and error (see below) before assuming a model ID actually works.
AWS_REGION=us-east-1

# Standard AWS credentials. Prefer an instance role / task role in production
# and leave these unset — the AWS SDK resolves the default credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Reasoning model used by the agent, invoked via the classic (non-Mantle)
# AnthropicBedrock client (src/lib/agent/runtime.ts) against Bedrock's
# on-demand cross-region inference profiles. Three things to know before
# changing this:
#
#  1. The newest Claude generation (Sonnet 5, Opus 4.8, Opus 4.7 — served via
#     the Mantle endpoint) requires an AWS Sales-approved access grant on
#     standard self-service accounts; a self-service account will get
#     `permission_error` even after fixing billing. This app therefore
#     targets the newest *generally available* model instead.
#  2. On-demand invocation needs the cross-region inference-profile form of
#     the model ID (`us.anthropic.claude-*`, not the bare `anthropic.claude-*`
#     ID that works fine in the console Playground but 400s over the API).
#  3. Bedrock model invocation requires a valid payment method on the AWS
#     account (`INVALID_PAYMENT_INSTRUMENT` otherwise) — separate from, and
#     in addition to, requesting model access.
#
# Verified working default for a fresh AWS account as of this writing:
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Effort and adaptive-thinking parameters are Claude 4.6+-only and are
# deliberately NOT sent by src/lib/agent/runtime.ts — Sonnet 4.5 (the default
# above) rejects them outright ("Extra inputs are not permitted"). This var is
# unused by the current model; keep it here for when BEDROCK_MODEL_ID moves to
# a 4.6+ model that supports it.
BEDROCK_EFFORT=medium

# Embedding model for semantic memory. Titan Text Embeddings V2 emits 1024 dims,
# which must match EMBEDDING_DIMENSIONS below and the VECTOR(n) column width.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024


# === Degraded modes (development only) ======================================

# When Bedrock is unreachable or unconfigured, Memento degrades instead of
# failing: the deterministic policy engine still produces an auditable decision
# and memory is embedded with a local lexical hash. Both are labelled as such in
# the UI and in the `agent_decisions` / `agent_memories` provider columns.
#
# Set to `false` to make Bedrock failures hard errors (recommended in production).
ALLOW_DEGRADED_AI=true


# === Application ============================================================

# Public base URL, used for absolute links in the audit trail.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# === CockroachDB Managed MCP Server (optional, developer tooling) ===========
#
# Generated into .mcp.json by `npm run mcp:config`. See docs/mcp.md.
# Copy these from CockroachDB Cloud Console -> your cluster -> MCP Server.
# CRDB_MCP_URL=
# CRDB_MCP_API_KEY=
