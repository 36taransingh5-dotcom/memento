# ---------------------------------------------------------------------------
# Memento environment configuration
#
# Copy to `.env.local` and fill in. Never commit real credentials.
#   cp .env.example .env.local
# ---------------------------------------------------------------------------


# === CockroachDB (required) =================================================

# Full CockroachDB connection string. Memento uses CockroachDB for ALL
# persistent state — structured records and vector memory alike.
#
# Local development (docker compose up -d):
DATABASE_URL=postgresql://root@localhost:26257/memento?sslmode=disable
#
# CockroachDB Cloud (copy from the Cloud Console -> Connect -> General connection string):
# DATABASE_URL=postgresql://<user>:<password>@<host>:26257/memento?sslmode=verify-full

# Maximum pooled connections. CockroachDB Cloud Basic clusters are metered on
# connection count; keep this modest for serverless deployments.
DATABASE_POOL_MAX=10


# === Amazon Bedrock (required for real agent reasoning) =====================

# Region hosting your Bedrock model access.
AWS_REGION=us-east-1

# Standard AWS credentials. Prefer an instance role / task role in production
# and leave these unset — the AWS SDK resolves the default credential chain.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Reasoning model used by the agent. Bedrock model IDs carry an `anthropic.` prefix.
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# Reasoning effort: low | medium | high | xhigh | max.
# `medium` keeps demo latency low; raise for harder operational decisions.
BEDROCK_EFFORT=medium

# Embedding model for semantic memory. Titan Text Embeddings V2 emits 1024 dims,
# which must match EMBEDDING_DIMENSIONS below and the VECTOR(n) column width.
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
EMBEDDING_DIMENSIONS=1024


# === Degraded modes (development only) ======================================

# When Bedrock is unreachable or unconfigured, Memento degrades instead of
# failing: the deterministic policy engine still produces an auditable decision
# and memory is embedded with a local lexical hash. Both are labelled as such in
# the UI and in the `agent_decisions` / `agent_memories` provider columns.
#
# Set to `false` to make Bedrock failures hard errors (recommended in production).
ALLOW_DEGRADED_AI=true


# === Application ============================================================

# Public base URL, used for absolute links in the audit trail.
NEXT_PUBLIC_APP_URL=http://localhost:3000


# === CockroachDB Managed MCP Server (optional, developer tooling) ===========
#
# Generated into .mcp.json by `npm run mcp:config`. See docs/mcp.md.
# Copy these from CockroachDB Cloud Console -> your cluster -> MCP Server.
# CRDB_MCP_URL=
# CRDB_MCP_API_KEY=
